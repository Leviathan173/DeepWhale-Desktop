{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepWhaleDesktop",
  "version": "0.1.2",
  "identifier": "com.leviathan.deepwhale-desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/headerImage.bmp",
        "uninstallerHeaderImage": "icons/headerImage.bmp",
        "sidebarImage": "icons/sidebarImage.bmp",
        "languages": ["ChineseSimplified", "English"]
      }
    }
  }
}